# Có bật mock hay không
VITE_USE_MOCK = false

# Địa chỉ gốc của API backend (bắt buộc)
# 【Trong Electron cần giữ nhất quán với cấu hình VITE_GLOB_DOMAIN_URL】
VITE_GLOB_API_URL=https://api3.boot.jeecg.com

# Địa chỉ đầy đủ của API backend (bắt buộc)
VITE_GLOB_DOMAIN_URL=https://api3.boot.jeecg.com

# Tiền tố đường dẫn gốc của API
VITE_GLOB_API_URL_PREFIX=

# Phiên bản chỉnh sửa tài liệu trực tuyến. Thuộc tính tùy chọn: wps, newWps (wps phiên bản mới), offlineWps (bản ngoại tuyến), onlyoffice
VITE_GLOB_ONLINE_DOCUMENT_VERSION=wps

# Ẩn toàn cục những bố cục nào. Thuộc tính tùy chọn: sider, header, multi-tabs; nhiều mục phân tách bằng dấu phẩy
#VITE_GLOB_HIDE_LAYOUT_TYPES=sider,header,multi-tabs

# -----------------------------------------
# ------------ Không nên sửa các tham số dưới đây ------------
# -----------------------------------------

# Đường dẫn phát hành
# 【Trong Electron chỉ dùng được đường dẫn tương đối bắt đầu bằng dấu ., nên dùng ./ 】
VITE_PUBLIC_PATH = ./

# Có bật nén gzip hoặc brotli hay không
# Giá trị tùy chọn: gzip | brotli | none
# Nếu cần nhiều mục, dùng dấu “,” để phân tách
# 【Trong Electron do truy cập tệp html cục bộ nên không cần nén】
VITE_BUILD_COMPRESS = 'none'

# Khi nén, có xóa tệp gốc hay không, mặc định là false
VITE_BUILD_COMPRESS_DELETE_ORIGIN_FILE = false

# ※ Không sửa mục này ※
VITE_GLOB_RUN_PLATFORM=electron
