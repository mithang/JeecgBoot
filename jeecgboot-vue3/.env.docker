# Có bật mock hay không
VITE_USE_MOCK = false

# Đường dẫn phát hành
VITE_PUBLIC_PATH = /

# Có bật nén gzip hoặc brotli hay không
# Giá trị tùy chọn: gzip | brotli | none
# Nếu cần nhiều mục, dùng dấu “,” để phân tách
VITE_BUILD_COMPRESS = 'gzip'

# Khi nén, có xóa tệp gốc hay không, mặc định là false
VITE_BUILD_COMPRESS_DELETE_ORIGIN_FILE = false

#Địa chỉ gốc của API backend (bắt buộc)
VITE_GLOB_API_URL=/jeecgboot

#Địa chỉ đầy đủ của API backend (bắt buộc)
VITE_GLOB_DOMAIN_URL=http://jeecg-boot-system:8080/jeecg-boot

# Tiền tố đường dẫn gốc của API
VITE_GLOB_API_URL_PREFIX=


# Điền vào để khởi động dưới dạng ứng dụng con qiankun, AppName khi đăng ký ở ứng dụng chính phải khớp (bỏ ghi chú tham số VITE_GLOB_QIANKUN_MICRO_APP_NAME nghĩa là jeecg-vue3 sẽ khởi động ở chế độ ứng dụng con qiankun)
#VITE_GLOB_QIANKUN_MICRO_APP_NAME=jeecg-vue3
# Bắt buộc khi khởi động dưới dạng ứng dụng con qiankun, phải khớp với entry đã điền khi ứng dụng chính qiankun đăng ký ứng dụng con
#VITE_GLOB_QIANKUN_MICRO_APP_ENTRY=//qiankun.boot3.jeecg.com/jeecg-vue3

# Ẩn toàn cục những bố cục nào. Thuộc tính tùy chọn: sider, header, multi-tabs; nhiều mục phân tách bằng dấu phẩy
#VITE_GLOB_HIDE_LAYOUT_TYPES=sider,header,multi-tabs

# Phiên bản chỉnh sửa tài liệu trực tuyến. Thuộc tính tùy chọn: wps, offlineWps (bản ngoại tuyến), onlyoffice
VITE_GLOB_ONLINE_DOCUMENT_VERSION=wps
