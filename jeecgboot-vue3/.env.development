# Có bật mock hay không
VITE_USE_MOCK = true

# Đường dẫn phát hành
VITE_PUBLIC_PATH = /


# Proxy cross-domain, có thể cấu hình nhiều mục, lưu ý không được xuống dòng
VITE_PROXY = [["/jeecgboot","http://localhost:8080/jeecg-boot"],["/upload","http://localhost:3300/upload"]]

#Địa chỉ đầy đủ của API backend (bắt buộc)
VITE_GLOB_DOMAIN_URL=http://localhost:8080/jeecg-boot

#Địa chỉ gốc của API backend (bắt buộc)
VITE_GLOB_API_URL=/jeecgboot

# Tiền tố API
VITE_GLOB_API_URL_PREFIX=

#Ứng dụng micro-frontend qiankun, tên phải bắt đầu bằng VITE_APP_SUB_; jeecg-app-1 là tên dự án của ứng dụng con, đồng thời là đường dẫn gốc của route
VITE_APP_SUB_jeecg-app-1 = '//localhost:8092'


# Điền vào để khởi động dưới dạng ứng dụng con qiankun, AppName khi đăng ký ở ứng dụng chính phải khớp (bỏ ghi chú tham số VITE_GLOB_QIANKUN_MICRO_APP_NAME nghĩa là jeecg-vue3 sẽ khởi động ở chế độ ứng dụng con qiankun)
#VITE_GLOB_QIANKUN_MICRO_APP_NAME=jeecg-vue3
# Bắt buộc khi khởi động dưới dạng ứng dụng con qiankun, phải khớp với entry đã điền khi ứng dụng chính qiankun đăng ký ứng dụng con
#VITE_GLOB_QIANKUN_MICRO_APP_ENTRY=//localhost:3001/jeecg-vue3

# Ẩn toàn cục những bố cục nào. Thuộc tính tùy chọn: sider, header, multi-tabs; nhiều mục phân tách bằng dấu phẩy
#VITE_GLOB_HIDE_LAYOUT_TYPES=sider,header,multi-tabs

# Phiên bản chỉnh sửa tài liệu trực tuyến. Thuộc tính tùy chọn: wps, newWps (wps phiên bản mới), offlineWps (bản ngoại tuyến), onlyoffice
VITE_GLOB_ONLINE_DOCUMENT_VERSION=wps

# Thư viện biểu tượng iconify của component icon dùng trực tuyến hay cục bộ. Thuộc tính tùy chọn: online, local
VITE_GLOB_ICONIFY_USE_TYPE=online
